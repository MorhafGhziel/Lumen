# Copy to .env.local and fill in. Every service below has a free tier that
# comfortably covers personal use.

# ── Supabase ────────────────────────────────────────────────────────────────
# supabase.com → your project → Project Settings → API
# The anon key is safe to expose: row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Gemini ──────────────────────────────────────────────────────────────────
# aistudio.google.com/apikey — free tier, no card required.
# Server-only: never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# ── Deployment ──────────────────────────────────────────────────────────────
# Only needed if the deployed origin cannot be inferred. Vercel sets its own.
# NEXT_PUBLIC_SITE_URL=https://lumen.example.com
